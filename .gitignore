_worker.bundle

# Local design review screenshots and marketing/demo collateral (not part of the app)
demo/
xhs/
*.png
!public/og.png

# StoryWeaver download cache (regenerated by scripts/sync-reading-stories.mjs)
storyweaver-*.json
